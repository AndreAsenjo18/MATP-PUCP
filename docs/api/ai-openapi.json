{
  "components": {
    "schemas": {
      "ColumnMappingCandidate": {
        "properties": {
          "column": {
            "description": "Encabezado tal como viene en el archivo.",
            "title": "Column",
            "type": "string"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Clave de ``target_fields`` propuesta, o null si no hay una clara.",
            "title": "Field"
          }
        },
        "required": [
          "column",
          "confidence"
        ],
        "title": "ColumnMappingCandidate",
        "type": "object"
      },
      "ColumnMappingRequest": {
        "description": "Body of ``/v1/suggest-column-mapping`` (change carga-masiva-con-ia): a column of an import\nfile has no saved template to map it, so the AI proposes a destination from ``target_fields``.",
        "examples": [
          {
            "headers": [
              "DENOMINACIÓN",
              "CÓDIGOS",
              "OBSERVACIONES"
            ],
            "sample_rows": [
              {
                "CÓDIGOS": "I-9201",
                "DENOMINACIÓN": "Arpa andina",
                "OBSERVACIONES": "Mide 95 cm de alto."
              }
            ],
            "target_fields": {
              "denomination": "Denominación",
              "notes": "Observaciones"
            }
          }
        ],
        "properties": {
          "headers": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Headers",
            "type": "array"
          },
          "sample_rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 20,
            "title": "Sample Rows",
            "type": "array"
          },
          "target_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Vocabulario de destino válido: campo interno -> etiqueta del contrato. La IA MUST NOT proponer un campo fuera de este diccionario.",
            "title": "Target Fields",
            "type": "object"
          }
        },
        "required": [
          "headers",
          "target_fields"
        ],
        "title": "ColumnMappingRequest",
        "type": "object"
      },
      "ColumnMappingResult": {
        "properties": {
          "mappings": {
            "items": {
              "$ref": "#/components/schemas/ColumnMappingCandidate"
            },
            "title": "Mappings",
            "type": "array"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "required": [
          "mappings"
        ],
        "title": "ColumnMappingResult",
        "type": "object"
      },
      "DescriptionResult": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "used_fields": {
            "items": {
              "type": "string"
            },
            "title": "Used Fields",
            "type": "array"
          }
        },
        "required": [
          "text",
          "used_fields"
        ],
        "title": "DescriptionResult",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExtractRequest": {
        "examples": [
          {
            "source_field": "notes",
            "text": "Alto 35 cm, ancho 20 cm. Exhibida en la muestra de retablos 1998. Regular estado."
          }
        ],
        "properties": {
          "source_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Campo de origen, p. ej. notes.",
            "title": "Source Field"
          },
          "text": {
            "description": "Texto libre (descripción, observaciones).",
            "maxLength": 20000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ExtractRequest",
        "type": "object"
      },
      "ExtractionResult": {
        "properties": {
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ProposedField"
            },
            "title": "Fields",
            "type": "array"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "required": [
          "fields"
        ],
        "title": "ExtractionResult",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "service": {
            "default": "ai",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "provider"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PieceContext": {
