# =============================================================================
# MATP - variables de entorno (plantilla)
# Copie este archivo como .env en la raíz:  cp .env.example .env
# Nunca suba .env al repositorio. Todos los valores de ejemplo son SOLO para
# desarrollo local; cámbielos en cualquier entorno compartido.
# Las variables marcadas [OBLIGATORIA] hacen que el servicio no arranque si faltan.
# =============================================================================

# --- General -----------------------------------------------------------------
# Entorno de ejecución: development | test | production
APP_ENV=development
# Versión informada por /health
APP_VERSION=0.1.0
# Nivel de logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Puertos publicados en el host (docker compose) ---------------------------
DB_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
API_PORT=8000
AI_PORT=8100
WEB_PORT=3000

# --- Base de datos PostgreSQL (servicio db) -----------------------------------
POSTGRES_DB=matp
POSTGRES_USER=matp
POSTGRES_PASSWORD=matp-dev-password
# [OBLIGATORIA] URL de SQLAlchemy usada por la API. En compose el host es "db".
# Contingencia free tier (Neon): postgresql+psycopg://usuario:clave@host/db?sslmode=require
DATABASE_URL=postgresql+psycopg://matp:matp-dev-password@db:5432/matp

# --- Almacenamiento S3-compatible (MinIO local / Cloudflare R2 / S3) ----------
# Credenciales del contenedor MinIO local
MINIO_ROOT_USER=matp-minio
MINIO_ROOT_PASSWORD=matp-minio-dev-password
# Endpoint S3 visto desde la API (vacío = AWS S3). R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://storage:9000
# Endpoint S3 visto desde el navegador (para URL prefirmadas); vacío = igual a S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
# [OBLIGATORIA] En local coinciden con MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ACCESS_KEY_ID=matp-minio
# [OBLIGATORIA]
S3_SECRET_ACCESS_KEY=matp-minio-dev-password
# [OBLIGATORIA] Bucket de fotos y documentos
S3_BUCKET=matp-media
# Crear el bucket al arrancar la API si no existe (solo desarrollo local)
S3_AUTO_CREATE_BUCKET=true

# --- Autenticación (JWT; se implementa en un change posterior) ----------------
# [OBLIGATORIA] Mínimo 16 caracteres. Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-development-secret-0123456789
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Comunicación entre servicios ---------------------------------------------
# URL del servicio de IA vista desde la API
AI_SERVICE_URL=http://ai:8100
# Orígenes permitidos por CORS en la API (separados por coma)
CORS_ORIGINS=http://localhost:3000
# Tiempo máximo (segundos) de cada verificación de dependencia en /health
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
# URL de la API y de la IA vistas desde el servidor Next.js (en compose: nombres de servicio)
API_INTERNAL_URL=http://api:8000
AI_INTERNAL_URL=http://ai:8100

# --- Servicio de IA (RN-009: toda salida requiere aprobación humana) ----------
# Proveedor: mock (por defecto, sin red, determinista) | llm (requiere LLM_API_KEY y LLM_MODEL)
AI_PROVIDER=mock
# Solo si AI_PROVIDER=llm
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Maqueta navegable (change maqueta-ui-navegable) --------------------------
# Modo de datos del frontend: mock (fixtures tipados, sin backend, por defecto en
# desarrollo local de la maqueta) | live (usa la API real vía NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_MODE=mock
# URL pública de la API para el modo "live" (vista desde el navegador de la persona)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Datos semilla (change modelo-datos-nucleo) -------------------------------
# Semilla aleatoria para datos sintéticos reproducibles
SEED_RANDOM_SEED=20260917
# Número de piezas sintéticas a generar
SEED_PIECE_COUNT=300
# Correo y contraseña del administrador sintético creado por el seed (solo desarrollo)
SEED_ADMIN_EMAIL=admin@matp.local
SEED_ADMIN_PASSWORD=change-me-admin-password
