      "SearchInterpretation": {
        "description": "Filtros que la IA reconoció, en el mismo vocabulario que el filtro único de búsqueda\n(`PieceFilter`, D2 de `design.md`): el backend valida cada valor contra el catálogo real y\ndescarta lo que no exista o lo que el permiso de quien pregunta no permita (D3) antes de\naplicarlo. Nunca incluye campos sensibles (valorización, comodante, préstamo): ni siquiera se\nle ofrece esa opción al modelo.",
        "properties": {
          "alert_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Código de alerta de completitud (p. ej. MISSING_PHOTO) de los que estén en valid_values.alert_labels.",
            "title": "Alert Code"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "collection_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collection Key"
          },
          "conservation_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conservation State"
          },
          "epoch_end_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epoch End Year"
          },
          "epoch_start_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epoch Start Year"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "provenance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provenance"
          },
          "q": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lo que sobra de la frase sin calzar con ningún filtro.",
            "title": "Q"
          },
          "tenure_regime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenure Regime"
          }
        },
        "title": "SearchInterpretation",
        "type": "object"
      },
      "SearchValidValues": {
        "description": "Valores vigentes del museo que la IA puede reconocer en una frase de búsqueda (change\n`busqueda-lenguaje-natural`, D2): cualquier valor que no aparezca aquí no se propone como\nfiltro. Las listas vienen de los mismos catálogos que ya alimentan los filtros manuales.",
        "properties": {
          "alert_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Código de alerta de completitud -> etiqueta en lenguaje llano, p. ej. MISSING_PHOTO -> 'sin foto'.",
            "title": "Alert Labels",
            "type": "object"
          },
