@startuml co_registro_pieza
!include _header.iuml
left to right direction
skinparam nodesep 60
skinparam ranksep 90
object ":Catalogador" as U <<actor>>
object ":EditorPieza" as W <<boundary>>
object ":PiecesRouter" as R <<controller>>
object ":Deps" as DP
object ":CatalogService" as CS <<service>>
object ":IdentificationService" as IS <<service>>
object ":AuditTracker" as AT
object ":Session / PostgreSQL" as DB
U -- W : "1: completarFicha()  →\n2: guardar()  →"
W -- R : "1.1: POST /pieces/validate  →\n2.1: POST /pieces  →\n← 2.1.4: 201 pieza | 409/422"
R -- DP : "2.1.1: current_user(), require_permission()  →"
R -- CS : "1.1.1: validate_piece_payload()  →\n2.1.2: create_piece(payload, ctx)  →"
CS -- IS : "1.1.1.1: normalize()  →\n2.1.2.1: add_identifier(\"I\", valor)  →"
CS -- AT : "2.1.3: flush()  →"
AT -- DB : "2.1.3.1: [guardas OK] INSERT piece,\npiece_identifier, audit_log  →"
CS -- DB : "1.1.1.2: SELECT código I vigente  →"
@enduml
