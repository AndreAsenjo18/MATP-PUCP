                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimensions Text"
          },
          "materials": {
            "items": {
              "type": "string"
            },
            "title": "Materials",
            "type": "array"
          },
          "period_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Text"
          },
          "piece_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Piece Id"
          },
          "provenance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provenance"
          },
          "technique": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Technique"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "PieceContext",
        "type": "object"
      },
      "ProposedField": {
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "field": {
            "description": "Campo de la ficha al que se propone el dato.",
            "title": "Field",
            "type": "string"
          },
          "source_fragment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Fragmento de texto que origina el dato.",
            "title": "Source Fragment"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "field",
          "value",
          "source_fragment",
          "confidence"
        ],
        "title": "ProposedField",
        "type": "object"
      },
      "SearchInterpretRequest": {
        "examples": [
          {
            "text": "toros de cerámica de Puno que no tengan foto",
            "valid_values": {
              "alert_labels": {
                "MISSING_PHOTO": "sin foto"
              },
              "categories": [
                "Figura zoomorfa"
              ],
              "collections": {
                "MMZ": "Colección MMZ"
              },
              "conservation_states": [
                "Bueno",
                "Regular",
                "Malo"
              ],
              "locations": [
                "Depósito 1"
              ],
              "materials": [
                "Cerámica"
              ],
              "tenure_regimes": [
                "Propia",
                "Comodato",
                "Préstamo temporal"
              ]
            }
          }
        ],
        "properties": {
          "text": {
            "description": "Frase en lenguaje natural, escrita o dictada.",
            "maxLength": 2000,
            "title": "Text",
            "type": "string"
          },
          "valid_values": {
            "$ref": "#/components/schemas/SearchValidValues"
