          "term_code",
          "label",
          "source_fragment",
          "confidence"
        ],
        "title": "TermSuggestion",
        "type": "object"
      },
      "TermSuggestionResult": {
        "properties": {
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/TermSuggestion"
