[Unit]
Description=Verificación de integridad de los respaldos de MATP
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/matp/app
EnvironmentFile=/opt/matp/.env.production
ExecStart=/opt/matp/app/scripts/backup/check.sh
# Sin privilegios extra: solo habla con Docker (grupo docker) y escribe en /opt/matp/state.
NoNewPrivileges=true
PrivateTmp=true
