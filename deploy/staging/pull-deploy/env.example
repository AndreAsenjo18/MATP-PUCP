# MATP - Configuración de CD2 en AWS Academy.
# Plantilla de referencia. No colocar credenciales reales aquí.

MATP_ENV=staging
MATP_ENV_FILE=/opt/matp/.env.pruebas

MATP_DEPLOY_STATE_DIR=/opt/matp/state
MATP_DEPLOYMENTS_LOG=/opt/matp/deployments.log

# Token GHCR con permiso read:packages.
# Solo se requiere si los paquetes no permiten lectura anónima.
# Almacenar exclusivamente en el servidor, nunca en GitHub.
GHCR_USERNAME=
GHCR_READ_TOKEN=

# Opcional: URL para alertas de despliegue.
ALERT_WEBHOOK_URL=