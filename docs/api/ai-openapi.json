  "info": {
    "description": "Servicio de IA asistiva desacoplado. Toda salida es una propuesta pendiente de aprobación humana (RN-009); el servicio no escribe en el catálogo.",
    "title": "MATP AI service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/describe": {
      "post": {
        "operationId": "describe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PieceContext"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionEnvelope_DescriptionResult_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Entrada no válida."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Proveedor de IA no disponible."
          }
        },
        "summary": "RIA-04: descripción preliminar desde metadatos",
        "tags": [
          "IA asistiva"
        ]
      }
    },
    "/v1/extract-structured": {
      "post": {
        "operationId": "extract_structured",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionEnvelope_ExtractionResult_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Entrada no válida."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Proveedor de IA no disponible."
          }
        },
        "summary": "RIA-01: proponer datos estructurados desde texto libre",
        "tags": [
          "IA asistiva"
        ]
      }
    },
    "/v1/interpret-search": {
      "post": {
        "operationId": "interpret_search",
        "requestBody": {
