# =============================================================================
# MATP - variables de entorno (plantilla)
# Copie este archivo como .env en la raíz:  cp .env.example .env
# Nunca suba .env al repositorio. Todos los valores de ejemplo son SOLO para
# desarrollo local; cámbielos en cualquier entorno compartido.
# Las variables marcadas [OBLIGATORIA] hacen que el servicio no arranque si faltan.
# =============================================================================

# --- General -----------------------------------------------------------------
# Entorno de ejecución: development | test | production
APP_ENV=development
# Versión informada por /health
APP_VERSION=0.1.0
# Identidad de la build informada por /health (change pipeline-despliegue-ambientes). No se definen a
# mano: APP_COMMIT lo fija la imagen (argumento de build GIT_SHA; "dev" en local) y APP_RELEASE lo
# fija deploy.sh con la etiqueta desplegada (sha-<commit> en pruebas, vX.Y.Z en producción).
# APP_COMMIT=dev
# APP_RELEASE=
# Nivel de logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Puertos publicados en el host (docker compose) ---------------------------
DB_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=3000

# --- Base de datos PostgreSQL (servicio db) -----------------------------------
POSTGRES_DB=matp
POSTGRES_USER=matp
POSTGRES_PASSWORD=matp-dev-password
# [OBLIGATORIA] URL de SQLAlchemy usada por la API. En compose el host es "db".
# Contingencia free tier (Neon): postgresql+psycopg://usuario:clave@host/db?sslmode=require
DATABASE_URL=postgresql+psycopg://matp:matp-dev-password@db:5432/matp

# --- Almacenamiento S3-compatible (MinIO local / Cloudflare R2 / S3) ----------
# Credenciales del contenedor MinIO local
MINIO_ROOT_USER=matp-minio
MINIO_ROOT_PASSWORD=matp-minio-dev-password
# Endpoint S3 visto desde la API (vacío = AWS S3). R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://storage:9000
# Endpoint S3 visto desde el navegador (para URL prefirmadas); vacío = igual a S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
# Vacías = cadena de credenciales por defecto de AWS (rol de instancia en EC2/AWS Academy).
# Deben definirse ambas o ninguna. En local coinciden con MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ACCESS_KEY_ID=matp-minio
S3_SECRET_ACCESS_KEY=matp-minio-dev-password
# [OBLIGATORIA] Bucket de fotos y documentos
S3_BUCKET=matp-media
# Crear el bucket al arrancar la API si no existe (solo desarrollo local)
S3_AUTO_CREATE_BUCKET=true

# --- Subida de fotografías (fotografias-multiples-por-pieza) -------------------
# Tamaño máximo de archivo (bytes). 50 MB por defecto [SUPUESTO C1].
MEDIA_MAX_BYTES=52428800
# Tipos MIME admitidos, separados por comas.
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/tiff
# TTL de URLs prefirmadas de descarga (segundos). 5 min.
MEDIA_URL_TTL_SECONDS=300
# TTL de URLs prefirmadas de subida (segundos). 15 min.
MEDIA_UPLOAD_URL_TTL_SECONDS=900
# Modo de subida: presigned (directo a S3) o proxy (a través de la API).
# presigned = recomendado; proxy = contingencia si el proveedor no soporta prefirmadas.
MEDIA_UPLOAD_MODE=presigned

# --- Fotos importadas con el Excel (importacion-masiva-fotografias) -------------
# Conservar el original de cada foto importada, además de su miniatura y su versión de
# visualización. false = solo los derivados, para una cuota limitada [SUPUESTO L2].
MEDIA_KEEP_ORIGINALS=true
# Umbral de la cuota de fotos, en bytes: al superarlo se avisa antes de aprobar un lote.
# Vacío = sin aviso, hasta conocer la cuota de la PUCP [SUPUESTO L2].
MEDIA_QUOTA_BYTES=

# --- Reporte de valorización (reportes-inventario, RF-037) --------------------
# Valorizaciones históricas por colección y moneda. Dato muy sensible (RNF-014): desactivado
# hasta confirmar con el museo que entra en la fase 1 [SUPUESTO]. Además del valor true, el
# usuario necesita el permiso sensitive.valuation. Carga: python -m app.reports.load_valuations
FEATURE_VALUATION_REPORT=false

# --- Autenticación: sesiones de servidor (ADR-009) ----------------------------
# No hay secreto compartido que configurar: el token de sesión es aleatorio y la base solo
# guarda su huella SHA-256. Los tiempos son [SUPUESTO C7], por confirmar con el museo.
# Minutos de inactividad que invalidan la sesión
SESSION_IDLE_MINUTES=30
# Duración máxima absoluta de una sesión, en horas
SESSION_MAX_HOURS=12
# Intentos fallidos consecutivos que bloquean la cuenta
LOGIN_MAX_FAILED_ATTEMPTS=5
# Minutos que dura el bloqueo temporal
LOGIN_LOCK_MINUTES=15
# Origen del frontend autorizado a enviar credenciales (CORS con cookies). Importa en la
# contingencia free tier, donde la web y la API están en dominios distintos.
WEB_ORIGIN=http://localhost:3000
# Proveedor de identidad: local (correo y contraseña, único implementado en la fase 1) |
# oidc (cuenta PUCP; stub documentado que responde "no disponible")
AUTH_PROVIDER=local
# Cookies de sesión y CSRF con el atributo Secure (solo HTTPS). En desarrollo local sin
# HTTPS debe ser false; con APP_ENV=production la API no arranca si es false.
COOKIE_SECURE=false
# Contraseña de los usuarios sintéticos del seed, para iniciar sesión en desarrollo sin la
# cabecera provisional. Déjela vacía en producción: los sintéticos no pueden iniciar sesión.
SEED_DEV_PASSWORD=change-me-dev-password

# --- Comunicación entre servicios ---------------------------------------------
# Ruta donde la API monta la IA asistiva (misma aplicación, mismo contenedor; ADR-008)
AI_MOUNT_PATH=/ai
# Orígenes permitidos por CORS en la API (separados por coma)
CORS_ORIGINS=http://localhost:3000
# Tiempo máximo (segundos) de cada verificación de dependencia en /health
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# --- Importación de hojas de cálculo [SUPUESTO: límites por confirmar con el museo] ---
# Tamaño máximo del archivo subido, en bytes (50 MB)
IMPORT_MAX_BYTES=52428800
# Número máximo de filas de datos por lote; más filas → lote "fallido en ingesta"
IMPORT_MAX_ROWS=20000
# Fotos por lote de importación. Es el tope de cada lote, no un límite global: las
# ≈ 25 000 fotos del museo se cargan en varios lotes [SUPUESTO]
IMPORT_MAX_PHOTOS=5000
# Días que se conservan los archivos de las fotos de lotes abandonados o descartadas
# antes de borrarlos [SUPUESTO]
IMPORT_PHOTO_RETENTION_DAYS=30
# Bits distintos (de 64) en la huella perceptual por debajo de los cuales dos fotos de un lote
# se proponen como la misma foto en otra resolución; 0 = solo huellas idénticas [SUPUESTO]
IMPORT_PHOTO_SIMILARITY_BITS=4
# URL de la API vista desde el servidor Next.js (en compose: nombre del servicio).
# La IA responde en esa misma URL, bajo AI_MOUNT_PATH.
API_INTERNAL_URL=http://api:8000

# --- Respaldos: estado visible en /health (change despliegue-vm-y-respaldos) ------
# Archivo JSON que escribe scripts/backup/backup-restic.sh tras cada ejecución. Vacío = sin respaldos
# configurados (desarrollo local): /health informa backup.status = disabled.
BACKUP_STATUS_FILE=
# Horas sin un respaldo exitoso a partir de las cuales /health informa backup.status = stale
# [SUPUESTO C6: respaldo diario + margen]
BACKUP_MAX_AGE_HOURS=26

# --- Producción en la VM (change despliegue-vm-y-respaldos; docs/despliegue/vm.md) ------
# Estas variables van en /opt/matp/.env.production (permisos 600, fuera del repositorio) y las
# leen deploy/vm/docker-compose.prod.yml y scripts/backup/*.sh. En desarrollo no se usan.
# Dominio de la VM: la web y la API cuelgan de él; las fotos salen por media.<dominio>
# MATP_DOMAIN=matp.example.pucp.edu.pe
# La define scripts/deploy.sh en cada despliegue; no la escriba a mano
# MATP_VERSION=v0.1.0
# Registro de imágenes (por defecto, el del repositorio)
# MATP_REGISTRY=ghcr.io/andreasenjo18
# Carpeta de la VM con el estado del despliegue y el marcador del último respaldo
# MATP_STATE_DIR=/opt/matp/state
# Ruta del marcador DENTRO del contenedor de la API (la carpeta anterior va montada en /var/lib/matp)
# BACKUP_STATUS_FILE=/var/lib/matp/backup-status.json
# Certificado institucional de la DTI (opcional; ver deploy/vm/Caddyfile)
# MATP_CERT_DIR=/opt/matp/certs
# Destino externo de respaldos (restic) y clave: la clave se custodia además FUERA de la VM
# RESTIC_REPOSITORY=s3:https://destino.example/matp-respaldos
# RESTIC_PASSWORD_FILE=/opt/matp/secrets/restic.key
# Si restic no está instalado en la VM se usa su imagen (restic 0.19.1, consultada el 2026-10-22)
# RESTIC_IMAGE=restic/restic:0.19.1
# Imagen de rclone para copiar el bucket al espejo local (rclone 1.75.2, consultada el 2026-10-24).
# Corre dentro de la red de Compose porque S3_ENDPOINT_URL=http://storage:9000 solo resuelve ahí
# RCLONE_IMAGE=rclone/rclone:1.75.2
# Credenciales del destino externo si es S3 compatible
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Retención de los respaldos [SUPUESTO C6]
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEEP_MONTHLY=6
# Aviso al Administrador cuando falla un respaldo o el disco se llena (webhook JSON {"text": ...})
# ALERT_WEBHOOK_URL=
# Porcentaje de uso de disco que dispara el aviso
# DISK_ALERT_THRESHOLD=80
# Imagen de la API con la que el simulacro comprueba el esquema (npm run restore:test)
# RESTORE_API_IMAGE=ghcr.io/andreasenjo18/matp-api:v0.1.0

# --- IA asistiva, dentro del proceso de la API (RN-009: toda salida requiere aprobación humana) ----------
# Proveedor: mock (por defecto, sin red, determinista) | llm (requiere LLM_API_KEY y LLM_MODEL)
AI_PROVIDER=mock
# Solo si AI_PROVIDER=llm
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Maqueta navegable (change maqueta-ui-navegable) --------------------------
# Modo de datos del frontend: mock (fixtures tipados, sin backend, por defecto en
# desarrollo local de la maqueta) | live (usa la API real vía NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_MODE=mock
# URL de la API para el modo "live". Vacío = mismo origen (recomendado): el navegador
# llama a /api/v1 relativo y Next (rewrites en local) o Caddy (staging/producción)
# reenvían a la API; así una sola imagen sirve para todos los entornos (design D9).
# Solo se define para apuntar a una API en otro dominio (contingencia free tier,
# ADR-009 punto 8), p. ej. https://api-ejemplo.example.com
NEXT_PUBLIC_API_URL=

# --- Datos semilla (change modelo-datos-nucleo) -------------------------------
# Semilla aleatoria para datos sintéticos reproducibles
SEED_RANDOM_SEED=20260917
# Número de piezas sintéticas a generar
SEED_PIECE_COUNT=300
# Correo y contraseña del administrador sintético creado por el seed (solo desarrollo)
SEED_ADMIN_EMAIL=admin@matp.local
SEED_ADMIN_PASSWORD=change-me-admin-password
